# steady-relay 环境变量示例（复制为 relay.env 后按需修改）
# 上游：ChatGPT 订阅 codex 后端（API-key 型上游请换成对应 /v1 地址并去掉 --passthrough）
UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex

# 全量缓冲模式: true=响应攒完整才交付（流中失败 100% 可重试，无打字机）
BUFFER_UNTIL_SUCCESS=true

# 订阅模式路径透传（跳过 /v1 前缀校验），也可用命令行 --passthrough
PASSTHROUGH=true

# 重试次数上限（0=不重试）
MAX_RETRIES=40

# 其余可选（默认值见 --help）：
# LISTEN_ADDR=127.0.0.1:8080
# RETRY_BACKOFF=500ms
# MAX_RETRY_AFTER=1m
# REQUEST_TIMEOUT=2m
