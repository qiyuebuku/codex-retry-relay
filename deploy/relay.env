# steady-relay 配置（改完执行: systemctl --user restart steady-relay）
# 上游：ChatGPT 订阅 codex 后端（API-key 型上游请换成对应 /v1 地址并去掉 --passthrough）
UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex

# 全量缓冲模式: true=响应攒完整才交付（流中失败 100% 可重试，无打字机）
#              false=实时流式（有打字机，流中失败会透传）
BUFFER_UNTIL_SUCCESS=true

# 订阅模式路径透传（等价 --passthrough）
PASSTHROUGH=true

# 重试次数上限（0=不重试；40 ≈ 极端拥堵硬扛约 4 分钟）
MAX_RETRIES=40

# 指标报表输出间隔（0 关闭）
STATS_INTERVAL=3m
